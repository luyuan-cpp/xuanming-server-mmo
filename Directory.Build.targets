<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <!--
      Normalize legacy toolset pinning (v145) to the VS default installed toolset.
      This keeps old vcxproj files buildable on newer VS versions without editing each project.
    -->
    <PlatformToolset Condition="'$(PlatformToolset)' == 'v145' and '$(DefaultPlatformToolset)' != ''">$(DefaultPlatformToolset)</PlatformToolset>

    <!-- Prefer latest C++ language mode across all C++ projects. -->
    <LanguageStandard>stdcpplatest</LanguageStandard>

    <!-- Speed-focused defaults for local C++ builds. -->
    <EnableModules>false</EnableModules>
    <BuildStlModules>false</BuildStlModules>
  </PropertyGroup>

  <ItemDefinitionGroup
      Condition="'$(MSBuildProjectExtension)' == '.vcxproj' and '$(Configuration)' == 'Debug'">
    <ClCompile>
      <!-- Always compile in parallel and avoid EditAndContinue overhead. -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!-- SDL checks add compile-time overhead; disable in local Debug for speed. -->
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkIncremental>true</LinkIncremental>
      <!-- VS 2026+ dropped /DEBUG:FASTLINK support; use /DEBUG:FULL instead. -->
      <AdditionalOptions>/DEBUG:FULL %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup
      Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <!-- protobuf v35.1 parse_context.h includes utf8_validity.h directly. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)third_party\protobuf\third_party\utf8_range\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- 生成的 gRPC 客户端复用 muduo 运行时，需要与现有 Windows 工程相同的兼容头。 -->
  <ItemDefinitionGroup Condition="'$(OS)' == 'Windows_NT' and '$(MSBuildProjectExtension)' == '.vcxproj' and '$(MSBuildProjectName)' == 'grpc_client'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)third_party\muduo\contrib\windows\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    裸指针成员检查只管本仓库自己的代码。按完整目录边界排除第三方工程，
    包括内嵌的 cpp\libs\engine\muduo_windows，兼容路径大小写和两种分隔符。
  -->
  <Target Name="NoRawPointerMemberCheck" BeforeTargets="PreBuildEvent"
          Condition="'$(MSBuildProjectExtension)' == '.vcxproj' and '$(SkipNoRawPointerMemberCheck)' != 'true' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectDirectory)', '(?i)(^|[\\/])(third_party|cpp[\\/]libs[\\/]engine[\\/]muduo_windows)([\\/]|$)'))">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\scripts\check_no_raw_pointer_member.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -ProjectName &quot;$(ProjectName)&quot; -ProjectFile &quot;$(MSBuildProjectFullPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -MSBuildPath &quot;$(MSBuildBinPath)\MSBuild.exe&quot;" />
  </Target>
  <!-- 独立 Protobuf 35.1 的编译器依赖与静态 zlib，由手写及生成工程共同继承。 -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <IndependentSdkRepositoryRoot Condition="'$(IndependentSdkRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)</IndependentSdkRepositoryRoot>
    <IndependentSdkProjectRelativePath>$([MSBuild]::MakeRelative('$(IndependentSdkRepositoryRoot)', '$(MSBuildProjectDirectory)'))</IndependentSdkProjectRelativePath>
    <IndependentSdkOwnCppProject>$([System.Text.RegularExpressions.Regex]::IsMatch('$(IndependentSdkProjectRelativePath)', '(?i)^cpp[\\/](generated|libs|nodes|tests)([\\/]|$)'))</IndependentSdkOwnCppProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IndependentSdkOwnCppProject)' == 'true' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">
    <IndependentSdkArchitectureSuffix Condition="'$(Platform)' == 'Win32'">_x86</IndependentSdkArchitectureSuffix>
    <IndependentSdkConfigurationSuffix Condition="'$(Configuration)' == 'Debug'">dbg</IndependentSdkConfigurationSuffix>
    <IndependentSdkConfigurationSuffix Condition="'$(Configuration)' == 'Release'">rel</IndependentSdkConfigurationSuffix>
    <IndependentSdkLibraryPostfix Condition="'$(Configuration)' == 'Debug'">d</IndependentSdkLibraryPostfix>
    <IndependentSdkZlibRoot>$(IndependentSdkRepositoryRoot)build/third_party/zlib-v1.3.2$(IndependentSdkArchitectureSuffix)-$(IndependentSdkConfigurationSuffix)/install/</IndependentSdkZlibRoot>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(IndependentSdkOwnCppProject)' == 'true' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release') and ('$(Platform)' == 'x64' or '$(Platform)' == 'Win32')">
    <Link>
      <!-- 不让 bin 里的历史 zlib DLL 或公共 lib 中的旧归档替代本轮 SDK。 -->
      <AdditionalLibraryDirectories>$(IndependentSdkZlibRoot)lib/;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$([System.Text.RegularExpressions.Regex]::Replace('%(AdditionalDependencies)', '(?i)(^|;)\s*zlib(?:static)?d?\.lib(?=;|$)', '$1zlibstatic$(IndependentSdkLibraryPostfix).lib'))</AdditionalDependencies>
      <AdditionalDependencies>$([System.Text.RegularExpressions.Regex]::Replace('%(AdditionalDependencies)', '(?i)(^|;)\s*libupbd?\.lib(?=;|$)', '$1libupb$(IndependentSdkLibraryPostfix).lib'))</AdditionalDependencies>
      <AdditionalDependencies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(AdditionalDependencies)', '(?i)(^|;)\s*libprotocd?\.lib(?=;|$)')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(AdditionalDependencies)', '(?i)(^|;)\s*libupbd?\.lib(?=;|$)'))">libupb$(IndependentSdkLibraryPostfix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>
