            },
            {
              "priority": 20, "action": "BATTLE_ACTION_SKILL", "skill_id": 1102,
              "conditions": [ { "kind": "BATTLE_SCRIPT_COND_ENEMY_COUNT_AT_LEAST", "p1": 3 } ],
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENEMY", "order": "BATTLE_SCRIPT_ORDER_HP_LOWEST" },
              "note": "敌人三个以上:群攻,主目标取血最少的"
            },
            {
              "priority": 30, "action": "BATTLE_ACTION_SKILL", "skill_id": 1101,
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENEMY", "order": "BATTLE_SCRIPT_ORDER_HP_LOWEST" },
              "note": "点杀血最少的"
            },
            {
              "priority": 40, "action": "BATTLE_ACTION_ATTACK",
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENEMY", "order": "BATTLE_SCRIPT_ORDER_HP_LOWEST" }
            }
          ]
        },
        {
          "role_id": 3, "order": 30, "name": "玄霄·跟打", "actor_type": "BATTLE_ACTOR_TYPE_PLAYER", "class_id": 2,
          "rules": [
            {
              "priority": 10, "action": "BATTLE_ACTION_SKILL", "skill_id": 1202,
