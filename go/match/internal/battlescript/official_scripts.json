{
  "scripts": [
    {
      "schema_version": 1,
      "script_id": 1,
      "name": "四职业·集火控速",
      "description": "丹心保命,破军点名集火,玄霄跟着破军的目标打,第四职业先给最快的敌人减速;宝宝跟集火。",
      "roles": [
        {
          "role_id": 1, "order": 10, "name": "丹心·治疗", "actor_type": "BATTLE_ACTOR_TYPE_PLAYER", "class_id": 3,
          "rules": [
            {
              "priority": 10, "action": "BATTLE_ACTION_SKILL", "skill_id": 1305,
              "target": { "side": "BATTLE_SCRIPT_TARGET_ALLY", "order": "BATTLE_SCRIPT_ORDER_HP_RATIO_LOWEST",
                          "filters": [ { "kind": "BATTLE_SCRIPT_FILTER_HP_BELOW", "p1": 3000 } ] },
              "note": "队友气血低于三成:先急救最危险的"
            },
            {
              "priority": 20, "action": "BATTLE_ACTION_SKILL", "skill_id": 1302,
              "target": { "side": "BATTLE_SCRIPT_TARGET_ALLY", "order": "BATTLE_SCRIPT_ORDER_HP_RATIO_LOWEST",
