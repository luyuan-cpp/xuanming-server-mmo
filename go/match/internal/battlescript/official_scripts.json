            {
              "priority": 10, "action": "BATTLE_ACTION_SKILL", "skill_id": 1104,
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENEMY", "order": "BATTLE_SCRIPT_ORDER_HP_HIGHEST",
                          "filters": [ { "kind": "BATTLE_SCRIPT_FILTER_IS_ACTOR_TYPE", "p1": 1 },
