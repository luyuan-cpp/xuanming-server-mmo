            },
            {
              "priority": 30, "action": "BATTLE_ACTION_ATTACK",
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENEMY",
                          "filters": [ { "kind": "BATTLE_SCRIPT_FILTER_CLAIMED_BY_ROLE", "p1": 2 } ] },
              "note": "没人要治:跟着破军集火"
            },
            {
              "priority": 40, "action": "BATTLE_ACTION_ATTACK",
              "target": { "side": "BATTLE_SCRIPT_TARGET_ENGINE_PICK" }
            }
          ]
        },
        {
          "role_id": 2, "order": 20, "name": "破军·点名", "actor_type": "BATTLE_ACTOR_TYPE_PLAYER", "class_id": 1,
