{{- range $svc := .ServiceInfo }}
{{- range $method := $svc.Methods }}
{{- if not (or $method.ClientStreaming $method.ServerStreaming) }}
#pragma region {{ $svc.Service }}{{ $method.Method }}
namespace {
void QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(GrpcDone<{{ $method.CppResponse }}> done, uint32_t code, std::string message) {
    QueueGrpcLocalCompletion([done = std::move(done), outcome = MakeLocalFailureOutcome(code, std::move(message))] {
        done(outcome, nullptr);
    });
}
}

// 请求必须在这里同步序列化:gate 的共享原型在下次调用会被覆盖。
// 若将来改成异步序列化,必须先恢复请求的独立副本。
void Start{{ $svc.Service }}{{ $method.Method }}Call(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                             GrpcSentMetadata metadata, std::chrono::milliseconds deadline,
                                             GrpcDone<{{ $method.CppResponse }}> done) {
    if (!done) {
        LOG_FATAL << "gRPC {{ $svc.Service }}.{{ $method.Method }} requires a done callback";
    }
    muduo_grpc::UnaryCallRequest unaryRequest;
    unaryRequest.method = std::string(k{{ $svc.Service }}{{ $method.Method }}GrpcPath);
    if (!request.SerializeToString(&unaryRequest.message)) {
        QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(std::move(done), kGrpcStatusInternal, "failed to serialize the request");
        return;
    }
    const auto channel = FindGrpcChannel(registry, nodeEntity);
    if (!channel) {
        QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(std::move(done), kGrpcStatusUnavailable, "node transport missing or closing");
        return;
    }
    unaryRequest.metadata.reserve(metadata.size());
    for (const auto& [key, value] : metadata) {
        // 仅 SessionMD 的 Go 解码器依赖额外应用编码;ASCII 认证头必须保留原值。
        // 所有 -bin 的线上编码另由传输层负责。
        unaryRequest.metadata.emplace_back(key, key == kSessionBinMetaKey ? Base64Encode(value) : value);
    }
    unaryRequest.deadline = std::chrono::steady_clock::now() + (deadline.count() > 0 ? deadline : DefaultCallDeadline());
    channel->StartUnaryCall(std::move(unaryRequest), [done = std::move(done)](muduo_grpc::UnaryCallResult&& result) {
        GrpcCallOutcome outcome;
        outcome.code = result.status.code_value();
        outcome.message = result.status.message();
        outcome.initialMetadata = std::move(result.initialMetadata);
        outcome.trailingMetadata = std::move(result.trailingMetadata);
        if (!outcome.ok()) {
            done(outcome, nullptr);
            return;
        }
        {{ $method.CppResponse }} reply;
        if (!reply.ParseFromString(result.response)) {
            outcome.code = kGrpcStatusInternal;
            outcome.message = "failed to parse the {{ $svc.Service }}.{{ $method.Method }} response";
            done(outcome, nullptr);
            return;
        }
        done(outcome, &reply);
    });
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                            GrpcDone<{{ $method.CppResponse }}> done, const GrpcCallOptions& options) {
    Start{{ $svc.Service }}{{ $method.Method }}Call(registry, nodeEntity, request, options.metadata, options.deadline, std::move(done));
}

void Send{{ $svc.Service }}{{ $method.Method }}Erased(entt::registry& registry, entt::entity nodeEntity, const google::protobuf::Message& message,
                                                  GrpcMessageDone done, const GrpcCallOptions& options) {
    if (!done) {
        LOG_FATAL << "gRPC {{ $svc.Service }}.{{ $method.Method }} requires a done callback";
    }
    if (message.GetDescriptor() != {{ $method.CppRequest }}::descriptor()) {
        const auto requestTypeName = message.GetDescriptor()->full_name();
        LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }}: request type " << std::string(requestTypeName.data(), requestTypeName.size())
                  << " does not match; not sent";
        QueueGrpcLocalCompletion([done = std::move(done), outcome = MakeLocalFailureOutcome(kGrpcStatusInternal, "request type mismatch")] {
            done(outcome, nullptr);
        });
        return;
    }
    // descriptor 相同仍可能是 DynamicMessage;进入 typed 路径前必须核对真实 C++ 类型。
    const auto* typedRequest = dynamic_cast<const {{ $method.CppRequest }}*>(&message);
    if (typedRequest == nullptr) {
        LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }}: request C++ type does not match; not sent";
        QueueGrpcLocalCompletion([done = std::move(done), outcome = MakeLocalFailureOutcome(kGrpcStatusInternal, "request type mismatch")] {
            done(outcome, nullptr);
        });
        return;
    }
    Start{{ $svc.Service }}{{ $method.Method }}Call(registry, nodeEntity, *typedRequest, options.metadata, options.deadline,
        [done = std::move(done)](const GrpcCallOutcome& outcome, const {{ $method.CppResponse }}* reply) { done(outcome, reply); });
}
