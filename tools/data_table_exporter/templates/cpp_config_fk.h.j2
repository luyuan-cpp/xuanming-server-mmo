{# cpp_config_fk.h.j2 -- foreign key cross-table lookup helpers (declarations only) #}
{%- import "_cpp_fk_helpers.j2" as fk with context -%}
#pragma once
#include <cstdint>
#include <vector>
{%- if table.foreign_key_columns | selectattr('data_type', 'equalto', 'string') | list %}
#include <string>
{%- endif %}

// 刻意只**前向声明**,不 include 任何表头。这些助手的签名里目标表只以
// const XTable* / std::vector<const XTable*> 的元素出现,指向不完整类型的指针
// 本身是完整类型,而函数**声明**从不要求返回/参数类型完整。
// 函数体在 <表名>_table_fk.cpp 里,那里才需要完整的 XTableManager。
//
// protoc 自己就在 table/proto/<表名>_table.pb.h 里写了同样的前向声明
// (全局作用域、无 package、无 dllexport_decl),所以这行是合法的重复声明。
class {{ sheetname }}Table;
{%- for target in fk_targets %}
class {{ target }}Table;
{%- endfor %}

// ---------------------------------------------------------------------------
// Foreign key helpers for {{ sheetname }}Table
// ---------------------------------------------------------------------------
{{ fk.emit('decl') }}
