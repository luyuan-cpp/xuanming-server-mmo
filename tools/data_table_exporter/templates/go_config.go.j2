    return row, ok
}

func (m *{{ sheetname }}TableManager) ExistsBy{{ to_go_proto_field(ck.group) }}({% for col in ck.columns %}{{ col.name }} {{ to_go_type(col.data_type) }}{% if not loop.last %}, {% endif %}{% endfor %}) bool {
    snap := m.snap.Load()
    _, ok := snap.compositeKv{{ to_go_proto_field(ck.group) }}[{{ sheetname }}{{ composite_go_struct_name(ck.group) }}{ {%- for col in ck.columns %}{{ to_go_proto_field(col.name) }}: {{ col.name }}, {% endfor -%} }]
