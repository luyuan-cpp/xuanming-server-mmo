{# go_config.go.j2 — per-table config manager struct #}
package table

import (
    "fmt"
    "math/rand/v2"
    "os"
    "path/filepath"
    "sync/atomic"

    "google.golang.org/protobuf/encoding/protojson"
    "google.golang.org/protobuf/proto"
    pb "{{ proto_import_path }}"
)

{% for ck in table.composite_keys %}
type {{ sheetname }}{{ composite_go_struct_name(ck.group) }} struct {
{%- for col in ck.columns %}
    {{ to_go_proto_field(col.name) }} {{ to_go_type(col.data_type) }}
{%- endfor %}
}
{% endfor %}

// {{ sheetname | lower }}Snapshot holds all parsed data and indices.
// Load() builds a new snapshot and swaps it in, replacing the old one.
type {{ sheetname | lower }}Snapshot struct {
    data   []*pb.{{ sheetname }}Table
{%- if table.multi_primary_key %}
    // 主键可重复:一个 id 对应多行
    kvData map[{{ to_go_type(table.id_column.data_type) }}][]*pb.{{ sheetname }}Table
{%- else %}
    kvData map[{{ to_go_type(table.id_column.data_type) }}]*pb.{{ sheetname }}Table
{%- endif %}
{%- for col in table.table_keys if not col.is_multi_key %}
    kv{{ to_go_proto_field(col.name) }}Data map[{{ to_go_type(col.data_type) }}]*pb.{{ sheetname }}Table
{%- endfor %}
{%- for col in table.table_keys if col.is_multi_key %}
    kv{{ to_go_proto_field(col.name) }}Data map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
    idx{{ to_go_proto_field(arr.name) }} map[{{ to_go_type(arr.data_type) }}][]*pb.{{ sheetname }}Table
{%- endfor %}
{%- for col in table.index_columns %}
    idx{{ to_go_proto_field(col.name) }} map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table
{%- endfor %}
{%- for ck in table.composite_keys %}
    compositeKv{{ to_go_proto_field(ck.group) }} map[{{ sheetname }}{{ composite_go_struct_name(ck.group) }}]*pb.{{ sheetname }}Table
{%- endfor %}
}

type {{ sheetname }}TableManager struct {
    // snap 指向不可变快照:Load 先整批建好新 snapshot,再原子换指针;读侧无锁 Load()。
    //
    // 热更契约:返回出去的 *pb 行属于**当时**那个快照。Go 有 GC,存着不会崩,
    // 但会永远拿到热更前的旧值。调用方**只存 id**,用的时候现查。
    // 不能退回裸字段 —— 热更的本质就是「服务跑着的时候再 Load 一次」,那一刻裸赋值与
    // 并发读就是数据竞争(go test -race 会报)。
    // 访问方法一律**在开头取一次**本地快照再用:同一次调用里多次 Load 可能拿到不同快照,
    // 表缩小时 data[rand.IntN(len(data))] 会越界。
    snap atomic.Pointer[{{ sheetname | lower }}Snapshot]
}

var {{ sheetname }}TableManagerInstance = New{{ sheetname }}TableManager()

func New{{ sheetname }}TableManager() *{{ sheetname }}TableManager {
    m := &{{ sheetname }}TableManager{}
    m.snap.Store(&{{ sheetname | lower }}Snapshot{
{%- if table.multi_primary_key %}
        kvData: make(map[{{ to_go_type(table.id_column.data_type) }}][]*pb.{{ sheetname }}Table),
{%- else %}
        kvData: make(map[{{ to_go_type(table.id_column.data_type) }}]*pb.{{ sheetname }}Table),
{%- endif %}
{%- for col in table.table_keys if not col.is_multi_key %}
        kv{{ to_go_proto_field(col.name) }}Data: make(map[{{ to_go_type(col.data_type) }}]*pb.{{ sheetname }}Table),
{%- endfor %}
{%- for col in table.table_keys if col.is_multi_key %}
        kv{{ to_go_proto_field(col.name) }}Data: make(map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
        idx{{ to_go_proto_field(arr.name) }}: make(map[{{ to_go_type(arr.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}{%- for col in table.index_columns %}
        idx{{ to_go_proto_field(col.name) }}: make(map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}{%- for ck in table.composite_keys %}
        compositeKv{{ to_go_proto_field(ck.group) }}: make(map[{{ sheetname }}{{ composite_go_struct_name(ck.group) }}]*pb.{{ sheetname }}Table),
{%- endfor %}
    })
    return m
}

func (m *{{ sheetname }}TableManager) Load(configDir string, useBinary bool) error {
    var container pb.{{ sheetname }}TableData

    if useBinary {
        path := filepath.Join(configDir, "{{ sheetname | lower }}.pb")
        raw, err := os.ReadFile(path)
        if err != nil {
            return fmt.Errorf("failed to read file: %w", err)
        }
        if err := proto.Unmarshal(raw, &container); err != nil {
            return fmt.Errorf("failed to parse binary: %w", err)
        }
    } else {
        path := filepath.Join(configDir, "{{ sheetname | lower }}.json")
        raw, err := os.ReadFile(path)
        if err != nil {
            return fmt.Errorf("failed to read file: %w", err)
        }
        if err := protojson.Unmarshal(raw, &container); err != nil {
            return fmt.Errorf("failed to parse json: %w", err)
        }
    }

    snap := &{{ sheetname | lower }}Snapshot{
{%- if table.multi_primary_key %}
        kvData: make(map[{{ to_go_type(table.id_column.data_type) }}][]*pb.{{ sheetname }}Table, len(container.Data)),
{%- else %}
        kvData: make(map[{{ to_go_type(table.id_column.data_type) }}]*pb.{{ sheetname }}Table, len(container.Data)),
{%- endif %}
{%- for col in table.table_keys if not col.is_multi_key %}
        kv{{ to_go_proto_field(col.name) }}Data: make(map[{{ to_go_type(col.data_type) }}]*pb.{{ sheetname }}Table, len(container.Data)),
{%- endfor %}
{%- for col in table.table_keys if col.is_multi_key %}
        kv{{ to_go_proto_field(col.name) }}Data: make(map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
        idx{{ to_go_proto_field(arr.name) }}: make(map[{{ to_go_type(arr.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}
{%- for col in table.index_columns %}
        idx{{ to_go_proto_field(col.name) }}: make(map[{{ to_go_type(col.data_type) }}][]*pb.{{ sheetname }}Table),
{%- endfor %}
{%- for ck in table.composite_keys %}
        compositeKv{{ to_go_proto_field(ck.group) }}: make(map[{{ sheetname }}{{ composite_go_struct_name(ck.group) }}]*pb.{{ sheetname }}Table, len(container.Data)),
{%- endfor %}
    }

    for _, row := range container.Data {
{%- if table.multi_primary_key %}
        snap.kvData[row.Id] = append(snap.kvData[row.Id], row)
{%- else %}
        snap.kvData[row.Id] = row
{%- endif %}
{%- for col in table.table_keys if not col.is_multi_key %}
        snap.kv{{ to_go_proto_field(col.name) }}Data[row.{{ to_go_proto_field(col.name) }}] = row
{%- endfor %}
{%- for col in table.table_keys if col.is_multi_key %}
        snap.kv{{ to_go_proto_field(col.name) }}Data[row.{{ to_go_proto_field(col.name) }}] = append(snap.kv{{ to_go_proto_field(col.name) }}Data[row.{{ to_go_proto_field(col.name) }}], row)
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
        for _, elem := range row.{{ to_go_proto_field(arr.name) }} {
            snap.idx{{ to_go_proto_field(arr.name) }}[elem] = append(snap.idx{{ to_go_proto_field(arr.name) }}[elem], row)
        }
{%- endfor %}
{%- for col in table.index_columns %}
        snap.idx{{ to_go_proto_field(col.name) }}[row.{{ to_go_proto_field(col.name) }}] = append(snap.idx{{ to_go_proto_field(col.name) }}[row.{{ to_go_proto_field(col.name) }}], row)
{%- endfor %}
{%- for ck in table.composite_keys %}
        snap.compositeKv{{ to_go_proto_field(ck.group) }}[{{ sheetname }}{{ composite_go_struct_name(ck.group) }}{ {%- for col in ck.columns %}{{ to_go_proto_field(col.name) }}: row.{{ to_go_proto_field(col.name) }}, {% endfor -%} }] = row
{%- endfor %}
    }

    snap.data = container.Data
    m.snap.Store(snap)
    return nil
}

func (m *{{ sheetname }}TableManager) FindAll() []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    return snap.data
}

{%- if table.multi_primary_key %}

// FindAllById 返回该 id 命中的**全部**行(表内顺序)。
// 这张表的主键声明了 (cfg_multi),所以不生成 FindById —— 把可重复主键当单值用
// 会在编译期断，而不是悄悄只看第一行。
func (m *{{ sheetname }}TableManager) FindAllById(id {{ to_go_type(table.id_column.data_type) }}) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    return snap.kvData[id]
}
{%- else %}

func (m *{{ sheetname }}TableManager) FindById(id {{ to_go_type(table.id_column.data_type) }}) (*pb.{{ sheetname }}Table, bool) {
    snap := m.snap.Load()
    row, ok := snap.kvData[id]
    return row, ok
}
{%- endif %}

{% for col in table.table_keys if not col.is_multi_key -%}
func (m *{{ sheetname }}TableManager) FindBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) (*pb.{{ sheetname }}Table, bool) {
    snap := m.snap.Load()
    row, ok := snap.kv{{ to_go_proto_field(col.name) }}Data[key]
    return row, ok
}

{% endfor %}
{%- for col in table.table_keys if col.is_multi_key %}
func (m *{{ sheetname }}TableManager) FindBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    return snap.kv{{ to_go_proto_field(col.name) }}Data[key]
}

{% endfor %}
{%- for arr in table.repeated_comp_arrays %}
func (m *{{ sheetname }}TableManager) FindBy{{ to_go_proto_field(arr.name) }}Index(key {{ to_go_type(arr.data_type) }}) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    return snap.idx{{ to_go_proto_field(arr.name) }}[key]
}

{% endfor %}
{%- for col in table.index_columns %}
func (m *{{ sheetname }}TableManager) GetBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    return snap.idx{{ to_go_proto_field(col.name) }}[key]
}

{% endfor %}

// ---- Exists ----

func (m *{{ sheetname }}TableManager) Exists(id {{ to_go_type(table.id_column.data_type) }}) bool {
    snap := m.snap.Load()
{%- if table.multi_primary_key %}
    return len(snap.kvData[id]) > 0
{%- else %}
    _, ok := snap.kvData[id]
    return ok
{%- endif %}
}

{% for col in table.table_keys if not col.is_multi_key -%}
func (m *{{ sheetname }}TableManager) ExistsBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) bool {
    snap := m.snap.Load()
    _, ok := snap.kv{{ to_go_proto_field(col.name) }}Data[key]
    return ok
}

{% endfor %}

// ---- Count ----

func (m *{{ sheetname }}TableManager) Count() int {
    snap := m.snap.Load()
    return len(snap.data)
}

{% for col in table.table_keys if col.is_multi_key -%}
func (m *{{ sheetname }}TableManager) CountBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) int {
    snap := m.snap.Load()
    return len(snap.kv{{ to_go_proto_field(col.name) }}Data[key])
}

{% endfor %}
{%- for arr in table.repeated_comp_arrays %}
func (m *{{ sheetname }}TableManager) CountBy{{ to_go_proto_field(arr.name) }}Index(key {{ to_go_type(arr.data_type) }}) int {
    snap := m.snap.Load()
    return len(snap.idx{{ to_go_proto_field(arr.name) }}[key])
}

{% endfor %}
{%- for col in table.index_columns %}
func (m *{{ sheetname }}TableManager) CountBy{{ to_go_proto_field(col.name) }}Index(key {{ to_go_type(col.data_type) }}) int {
    snap := m.snap.Load()
    return len(snap.idx{{ to_go_proto_field(col.name) }}[key])
}

{% endfor %}

// ---- FindByIds (IN) ----

func (m *{{ sheetname }}TableManager) FindByIds(ids []{{ to_go_type(table.id_column.data_type) }}) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    result := make([]*pb.{{ sheetname }}Table, 0, len(ids))
    for _, id := range ids {
{%- if table.multi_primary_key %}
        result = append(result, snap.kvData[id]...)
{%- else %}
        if row, ok := snap.kvData[id]; ok {
            result = append(result, row)
        }
{%- endif %}
    }
    return result
}

// ---- RandOne ----

func (m *{{ sheetname }}TableManager) RandOne() (*pb.{{ sheetname }}Table, bool) {
    snap := m.snap.Load()
    if len(snap.data) == 0 {
        return nil, false
    }
    return snap.data[rand.IntN(len(snap.data))], true
}

{% for col in table.table_keys if col.is_multi_key -%}
func (m *{{ sheetname }}TableManager) RandOneBy{{ to_go_proto_field(col.name) }}(key {{ to_go_type(col.data_type) }}) (*pb.{{ sheetname }}Table, bool) {
    snap := m.snap.Load()
    rows := snap.kv{{ to_go_proto_field(col.name) }}Data[key]
    if len(rows) == 0 {
        return nil, false
    }
    return rows[rand.IntN(len(rows))], true
}

{% endfor %}

// ---- Where / First ----

func (m *{{ sheetname }}TableManager) Where(pred func(*pb.{{ sheetname }}Table) bool) []*pb.{{ sheetname }}Table {
    snap := m.snap.Load()
    var result []*pb.{{ sheetname }}Table
    for _, row := range snap.data {
        if pred(row) {
            result = append(result, row)
        }
    }
    return result
}

func (m *{{ sheetname }}TableManager) First(pred func(*pb.{{ sheetname }}Table) bool) (*pb.{{ sheetname }}Table, bool) {
    snap := m.snap.Load()
    for _, row := range snap.data {
        if pred(row) {
            return row, true
        }
    }
    return nil, false
}

