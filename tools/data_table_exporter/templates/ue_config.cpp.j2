bool {{ mgr_class }}::LoadFromJson(const FString& JsonText, FString& OutError)
{
	TSharedPtr<FJsonObject> Root;
	const TSharedRef<TJsonReader<TCHAR>> Reader = TJsonReaderFactory<TCHAR>::Create(JsonText);
	if (!FJsonSerializer::Deserialize(Reader, Root) || !Root.IsValid())
	{
		OutError = FString::Printf(TEXT("[{{ sheetname }}] %s 不是合法 JSON: %s"), TEXT("{{ json_file }}"), *Reader->GetErrorMessage());
		return false;
	}

	// 顶层形状是 {"data": [ {...}, ... ]}(见 core/generators/json_gen.py)。
	const TSharedPtr<FJsonValue>* DataField = Root->Values.Find(TEXT("data"));
	if (DataField == nullptr || !DataField->IsValid() || (*DataField)->Type != EJson::Array)
	{
		OutError = TEXT("[{{ sheetname }}] {{ json_file }} 顶层缺少数组字段 \"data\"");
		return false;
	}
	const TArray<TSharedPtr<FJsonValue>>& DataArray = (*DataField)->AsArray();

	// 整批建新快照;中途任何一行失败都直接返回,**现有快照原封不动**。
	TSharedRef<FSnapshot> NewSnapshot = MakeShared<FSnapshot>();
	NewSnapshot->Rows.Reserve(DataArray.Num());

	TSet<FString> CheckedKeys;
	for (int32 RowIndex = 0; RowIndex < DataArray.Num(); ++RowIndex)
	{
		const TSharedPtr<FJsonValue>& Element = DataArray[RowIndex];
		if (!Element.IsValid() || Element->Type != EJson::Object)
		{
			OutError = FString::Printf(TEXT("[{{ sheetname }}] data[%d] 不是对象"), RowIndex);
			return false;
		}
		const TSharedPtr<FJsonObject>& RowObject = Element->AsObject();
		{{ sheetname }}TableAuditJsonKeys(RowObject, CheckedKeys);
{%- if narrowed or narrowed_groups %}
		// 值域检查只打日志、不中断装载:一个越界的格子不该让整张表停在旧一代,
		// 但它必须在日志里有名有姓。
		{{ sheetname }}TableCheckNarrowedRow(RowObject, RowIndex);
{%- endif %}

		// 必须 value-init:导表器的 JSON **按行省略空单元格**,而 FJsonObjectConverter
		// 对缺席的键是静默跳过、不写。写成 `Row;` 那些列就是未初始化内存 ——
		// 不是 0,不报错,shipping 里一样。
		{{ row_struct }} Row{};
		// CheckFlags/SkipFlags 都传 0:全部 UPROPERTY 都参与匹配。
		// 匹配靠「属性名 == JSON 键」(TMap<FString> 查找,忽略大小写),所以
		// {{ row_struct }} 的字段名是 snake_case —— 见 {{ row_header }}.h 的文件头。
		if (!FJsonObjectConverter::JsonObjectToUStruct<{{ row_struct }}>(RowObject.ToSharedRef(), &Row, 0, 0))
		{
			OutError = FString::Printf(TEXT("[{{ sheetname }}] data[%d] 转 {{ row_struct }} 失败"), RowIndex);
			return false;
		}
		NewSnapshot->Rows.Add(MoveTemp(Row));
	}

	BuildIndices(NewSnapshot.Get());

	// 原子换代:旧快照在最后一个 PinSnapshot() 持有者放手时析构。
	Snapshot = NewSnapshot;
	UE_LOG(LogConfigTable, Log, TEXT("[{{ sheetname }}] 装载 %d 行"), NewSnapshot->Rows.Num());
	return true;
}

bool {{ mgr_class }}::LoadFromDir(const FString& ConfigDir, FString& OutError)
{
	const FString Path = FPaths::Combine(ConfigDir, FileName());
	FString JsonText;
	if (!FFileHelper::LoadFileToString(JsonText, *Path))
	{
		OutError = FString::Printf(TEXT("[{{ sheetname }}] 读不到配置文件: %s"), *Path);
		return false;
	}
	return LoadFromJson(JsonText, OutError);
}

void {{ mgr_class }}::BuildIndices(FSnapshot& Snap)
{
	const int32 RowCount = Snap.Rows.Num();
{%- if not table.multi_primary_key %}
	Snap.IdIndex.Reserve(RowCount);
{%- endif %}
	for (int32 RowIndex = 0; RowIndex < RowCount; ++RowIndex)
	{
		const {{ row_struct }}& Row = Snap.Rows[RowIndex];
{%- if table.multi_primary_key %}
		Snap.IdIndex.FindOrAdd(Row.{{ table.id_column.name }}).Add(RowIndex);
{%- else %}
		// 重复 id 会覆盖前一行。这张表的主键**不是** (cfg_multi),重复即配置错误。
		if (int32* Existing = Snap.IdIndex.Find(Row.{{ table.id_column.name }}))
		{
			UE_LOG(LogConfigTable, Error,
				TEXT("[{{ sheetname }}] id=%s 重复(行 %d 与行 %d);这张表没有标 (cfg_multi),后一行会覆盖前一行"),
				*LexToString(Row.{{ table.id_column.name }}), *Existing, RowIndex);
		}
		Snap.IdIndex.Add(Row.{{ table.id_column.name }}, RowIndex);
{%- endif %}
{%- for col in table.table_keys %}
{%- if col.is_multi_key %}
		Snap.{{ to_pascal_case(col.name) }}Map.FindOrAdd(Row.{{ col.name }}).Add(RowIndex);
{%- else %}
		// 唯一键重复也是配置错误,与 id 同一口径:不打日志就只剩「查出来的行不是我填的那行」。
		if (int32* Existing{{ to_pascal_case(col.name) }} = Snap.{{ to_pascal_case(col.name) }}Map.Find(Row.{{ col.name }}))
		{
			UE_LOG(LogConfigTable, Error,
				TEXT("[{{ sheetname }}] 唯一键 {{ col.name }}=%s 重复(行 %d 与行 %d);这一列标的是 (cfg_key) 而不是 (cfg_key multi),后一行会覆盖前一行"),
				*LexToString(Row.{{ col.name }}), *Existing{{ to_pascal_case(col.name) }}, RowIndex);
		}
		Snap.{{ to_pascal_case(col.name) }}Map.Add(Row.{{ col.name }}, RowIndex);
{%- endif %}
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
		for (const {{ to_ue_type(arr.data_type) }}& Element : Row.{{ arr.name }})
		{
			// 同一行同一个值只塞一次。定长数组补位、重复填同一个 id 在配置表里很常见,
			// 不去重的话 GetRowsBy{{ to_pascal_case(arr.name) }}() 会把这一行返回 N 遍、
			// CountBy{{ to_pascal_case(arr.name) }}Index() 会数成 N 而不是 1。
			// 行是按 RowIndex 递增处理的,所以本行的下标只可能在桶尾。
			TArray<int32>& Bucket = Snap.{{ to_pascal_case(arr.name) }}ValueIndex.FindOrAdd(Element);
			if (Bucket.Num() == 0 || Bucket.Last() != RowIndex)
			{
				Bucket.Add(RowIndex);
			}
		}
{%- endfor %}
{%- for col in table.index_columns %}
		Snap.{{ to_pascal_case(col.name) }}Index.FindOrAdd(Row.{{ col.name }}).Add(RowIndex);
{%- endfor %}
{%- for ck in table.composite_keys %}
		{
			{{ ue_composite_struct_name(sheetname, ck.group) }} CompositeKey;
{%- for col in ck.columns %}
			CompositeKey.{{ col.name }} = Row.{{ col.name }};
{%- endfor %}
			Snap.{{ to_pascal_case(ck.group) }}Composite.Add(CompositeKey, RowIndex);
		}
{%- endfor %}
	}
}

