TArray<const {{ row_struct }}*> {{ mgr_class }}::FindAllById({{ to_ue_param_type(table.id_column.data_type) }} Id) const
{
	TArray<const {{ row_struct }}*> Result;
	const TArray<int32>& Indices = FindAllIdIndices(Id);
	Result.Reserve(Indices.Num());
	for (const int32 RowIndex : Indices)
	{
		Result.Add(&Snapshot->Rows[RowIndex]);
	}
	return Result;
}

const TArray<int32>& {{ mgr_class }}::FindAllIdIndices({{ to_ue_param_type(table.id_column.data_type) }} Id) const
{
	const TArray<int32>* Found = Snapshot->IdIndex.Find(Id);
	return Found != nullptr ? *Found : G{{ sheetname }}EmptyIndices;
}

void {{ mgr_class }}::K2_FindAllById({{ id_type }} Id, TArray<{{ row_struct }}>& OutRows) const
{
	OutRows.Reset();
	const TArray<int32>& Indices = FindAllIdIndices(Id);
	OutRows.Reserve(Indices.Num());
	for (const int32 RowIndex : Indices)
	{
		OutRows.Add(Snapshot->Rows[RowIndex]);
	}
}

int32 {{ mgr_class }}::CountById({{ to_ue_param_type(table.id_column.data_type) }} Id) const
{
	return FindAllIdIndices(Id).Num();
}
{% else %}
const {{ row_struct }}* {{ mgr_class }}::FindById({{ to_ue_param_type(table.id_column.data_type) }} Id) const
{
	const {{ row_struct }}* Row = FindByIdSilent(Id);
	if (Row == nullptr)
	{
		UE_LOG(LogConfigTable, Warning, TEXT("[{{ sheetname }}] 查不到 id=%s"), *LexToString(Id));
	}
	return Row;
}

const {{ row_struct }}* {{ mgr_class }}::FindByIdSilent({{ to_ue_param_type(table.id_column.data_type) }} Id) const
{
	const int32* RowIndex = Snapshot->IdIndex.Find(Id);
	return RowIndex != nullptr ? &Snapshot->Rows[*RowIndex] : nullptr;
}

bool {{ mgr_class }}::K2_FindById({{ id_type }} Id, {{ row_struct }}& OutRow) const
{
	if (const {{ row_struct }}* Row = FindByIdSilent(Id))
	{
		OutRow = *Row;
		return true;
	}
	OutRow = {{ row_struct }}();
	return false;
}
{% endif %}

TArray<const {{ row_struct }}*> {{ mgr_class }}::FindByIds(const TArray<{{ id_type }}>& Ids) const
{
	TArray<const {{ row_struct }}*> Result;
	Result.Reserve(Ids.Num());
	for (const {{ id_type }} Id : Ids)
	{
{%- if table.multi_primary_key %}
		for (const int32 RowIndex : FindAllIdIndices(Id))
		{
			Result.Add(&Snapshot->Rows[RowIndex]);
		}
{%- else %}
		if (const {{ row_struct }}* Row = FindByIdSilent(Id))
		{
			Result.Add(Row);
		}
{%- endif %}
	}
	return Result;
}

const {{ row_struct }}* {{ mgr_class }}::RandOne() const
{
	// 返回的指针属于当前快照,只在下一次 Load() 之前有效 —— 调用方只存 id。
	if (Snapshot->Rows.Num() == 0)
	{
		return nullptr;
	}
	return &Snapshot->Rows[FMath::RandRange(0, Snapshot->Rows.Num() - 1)];
}
