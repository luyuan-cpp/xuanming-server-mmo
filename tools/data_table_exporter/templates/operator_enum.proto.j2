{# operator_enum.proto.j2 — one file per operator group #}
syntax = "proto3";

option go_package = "generated/pb/table";
{% if java_package %}
option java_package = "{{ java_package }}";
{% endif %}

enum {{ group_name }} {
  k{{ group_name | capitalize }}OK = 0;
{% for enum_name, _ in entries %}
  k{{ enum_name }} = {{ id_map[enum_name] }};
{% endfor %}
};
