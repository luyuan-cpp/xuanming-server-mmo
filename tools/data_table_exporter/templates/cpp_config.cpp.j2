std::string GetConfigDir();
bool UseProtoBinaryTables();

bool {{ sheetname }}TableManager::ParseSnapshotFromDir(
    const std::string& configDir,
    const bool useBinary,
    std::shared_ptr<const Snapshot>& out,
    std::string& err) {
    std::string prefix = configDir;
    if (!prefix.empty() && prefix.back() != '/' && prefix.back() != '\\') {
        prefix.push_back('/');
    }
    const std::string path = prefix + (useBinary ? "{{ sheetname | lower }}.pb" : "{{ sheetname | lower }}.json");
    std::ifstream input(path, std::ios::binary);
    if (!input.is_open()) {
        err = "failed to open {{ sheetname }} table file: " + path;
        return false;
    }
    std::ostringstream buffer;
    buffer << input.rdbuf();
    if (input.bad()) {
        err = "failed to read {{ sheetname }} table file: " + path;
        return false;
    }
    const std::string contents = buffer.str();

    auto snap = std::make_shared<Snapshot>();
    if (useBinary) {
        if (!snap->data.ParseFromString(contents)) {
            err = "{{ sheetname }} binary parse failed: " + path;
            return false;
        }
    } else {
        if (const auto result = google::protobuf::util::JsonStringToMessage(contents, &snap->data); !result.ok()) {
            err = std::string("{{ sheetname }} json parse failed: ") + std::string(result.message());
            return false;
        }
    }

    for (int32_t i = 0; i < snap->data.data_size(); ++i) {
        const auto& row_data = snap->data.data(i);
        snap->idMap.emplace(row_data.id(), &row_data);
{%- for col in table.table_keys %}
        snap->{{ to_camel_case(col.name) }}Map.emplace(row_data.{{ col.name }}(), &row_data);
{%- endfor %}
{%- for arr in table.repeated_comp_arrays %}
        for (const auto& elem : row_data.{{ arr.name }}()) {
            snap->{{ to_camel_case(arr.name) }}Index.emplace(elem, &row_data);
        }
{%- endfor %}
{%- for col in table.index_columns %}
        snap->{{ to_camel_case(col.name) }}Index[row_data.{{ col.name }}()].push_back(&row_data);
{%- endfor %}
{%- for ck in table.composite_keys %}
        snap->{{ to_camel_case(ck.group) }}Composite.emplace({{ sheetname }}{{ composite_cpp_struct_name(ck.group) }}{ {%- for col in ck.columns %}row_data.{{ col.name }}(){% if not loop.last %}, {% endif %}{% endfor -%} }, &row_data);
{%- endfor %}
    }
{%- for col in table.expression_columns if col.expression_params %}

    snap->{{ to_camel_case(col.name) }}Expr.Init({
{%- for p in col.expression_params %}
        "{{ p }}"{% if not loop.last %}, {% endif %}
{%- endfor %}
    });
{%- endfor %}

    out = std::move(snap);
    return true;
}

void {{ sheetname }}TableManager::Load() {
    std::shared_ptr<const Snapshot> snap;
    std::string err;
    if (!ParseSnapshotFromDir(GetConfigDir(), UseProtoBinaryTables(), snap, err)) {
        LOG_FATAL << err;
    }
    InstallSnapshot(std::move(snap));
}

{%- if not table.multi_primary_key %}

std::pair<const {{ sheetname }}Table*, uint32_t> {{ sheetname }}TableManager::FindById(const uint32_t tableId) {
    const auto& snap = GetSnapshot();
    const auto it = snap.idMap.find(tableId);
    if (it == snap.idMap.end()) {
        LOG_ERROR << "{{ sheetname }} table not found for ID: " << tableId;
        return {nullptr, kInvalidTableId};
    }
    return {it->second, kSuccess};
}

std::pair<const {{ sheetname }}Table*, uint32_t> {{ sheetname }}TableManager::FindByIdSilent(const uint32_t tableId) {
    const auto& snap = GetSnapshot();
    const auto it = snap.idMap.find(tableId);
    if (it == snap.idMap.end()) {
        return {nullptr, kInvalidTableId};
    }
    return {it->second, kSuccess};
}
