{% for col in table.table_keys -%}
std::pair<const {{ sheetname }}Table*, uint32_t> {{ sheetname }}TableManager::FindBy{{ to_pascal_case(col.name) }}({{ to_cpp_param_type(col.data_type) }} key) const {
    const auto& snap = GetSnapshot();
    const auto it = snap.{{ to_camel_case(col.name) }}Map.find(key);
    if (it == snap.{{ to_camel_case(col.name) }}Map.end()) {
        LOG_ERROR << "{{ sheetname }} table not found for {{ col.name }}: " << key;
        return {nullptr, kInvalidTableId};
    }
    return {it->second, kSuccess};
}

