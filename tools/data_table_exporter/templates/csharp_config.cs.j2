        /// 这会直接推翻本类型宣称的「不可变快照」。冻成数组之后强转也改不动。
        /// </summary>
        private static void Freeze<TKey>(Dictionary<TKey, IReadOnlyList<{{ ROW }}>> map)
        {
            List<TKey> keys = new List<TKey>(map.Keys);
            for (int i = 0; i < keys.Count; i++)
            {
                List<{{ ROW }}> bucket = (List<{{ ROW }}>)map[keys[i]];
                map[keys[i]] = bucket.ToArray();
            }
        }

        private static int NextInt(int exclusiveMax)
        {
            Random rng = s_random;
            if (rng == null)
            {
                rng = new Random(unchecked((Environment.TickCount * 397) ^ Thread.CurrentThread.ManagedThreadId));
                s_random = rng;
            }
            return rng.Next(exclusiveMax);
        }
    }
}
