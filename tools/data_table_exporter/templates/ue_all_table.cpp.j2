		++LoadVersion;
	}
	if (bAllOk)
	{
		UE_LOG(LogConfigTable, Log, TEXT("全部 %d 张配置表装载完成(第 %d 代,provider)"), TableCount, LoadVersion);
	}
	else if (bAnySwapped)
	{
		UE_LOG(LogConfigTable, Error,
			TEXT("配置表装载有失败项,表集合处于混代状态(失效版本号已 +1 到 %d,provider)"), LoadVersion);
