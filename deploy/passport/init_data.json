{
  "organizations": [
    {
      "owner": "admin",
      "name": "xuanming",
      "displayName": "Xuanming Passport",
      "passwordType": "argon2id",
      "passwordOptions": [
        "AtLeast8"
      ],
      "countryCodes": [
        "CN"
      ],
      "initScore": 0,
      "enableSoftDeletion": false,
      "recordRetentionDays": 180,
      "securityPolicy": {
        "stuffingFailureThreshold": 30,
        "stuffingBlockMinutes": 15,
        "smsPerPhoneHourly": 5,
        "smsPerPhoneDaily": 10,
        "smsPerPrefixHourly": 100,
        "smsDomesticOnly": true,
        "smsDailyAlertCount": 10000
      }
    }
  ],
  "applications": [
    {
      "owner": "admin",
      "name": "app-xuanming-game",
      "displayName": "Xuanming MMO",
      "organization": "xuanming",
      "clientId": "xuanming-game-client",
      "cert": "cert-built-in",
      "enablePassword": true,
      "enableSignUp": true,
      "enableSigninSession": false,
      "enableCodeSignin": true,
      "tokenFormat": "JWT-Standard",
      "expireInHours": 1,
      "refreshExpireInHours": 24,
      "grantTypes": [
        "authorization_code"
      ],
      "redirectUris": [
        "http://127.0.0.1:18765/passport/callback",
        "xuanming://passport/callback"
      ],
      "providers": [
        {
          "name": "provider_captcha_default",
          "canSignUp": false,
          "canSignIn": false,
          "canUnlink": false,
          "prompted": false,
          "signupGroup": "",
          "rule": "Always"
        }
      ],
      "signupItems": [
        {
          "name": "Username",
          "visible": true,
          "required": true,
          "prompted": false,
          "rule": "None"
        },
        {
          "name": "Email",
          "visible": true,
          "required": true,
          "prompted": false,
          "rule": "Normal"
        },
        {
          "name": "Password",
          "visible": true,
          "required": true,
          "prompted": false,
          "rule": "None"
        },
        {
          "name": "Confirm password",
          "visible": true,
          "required": true,
          "prompted": false,
          "rule": "None"
        }
      ]
    },
    {
      "owner": "admin",
      "name": "app-xuanming-server",
      "displayName": "Xuanming Game Server",
      "organization": "xuanming",
      "clientId": "xuanming-game-server",
      "cert": "cert-built-in",
      "enablePassword": false,
      "enableSignUp": false,
      "enableSigninSession": false,
      "enableCodeSignin": false,
      "grantTypes": [
        "client_credentials"
      ],
      "redirectUris": []
    }
  ]
}
