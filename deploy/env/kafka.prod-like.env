# Production-like profile: closer to cluster behavior for load/regression testing
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
# Broker default retention = the retention of every topic that does not declare its
# own (migration-window per-node topics gate-<id>/scene-<id>, game-events).
# Must exceed the longest a consumer can legally lag: the C++ consumers pin
# max.poll.interval.ms=900000 (15 min), so anything below 900s silently drops
# BindSession/RoutePlayer for a briefly-lagging gate instead of letting it catch up
# (docs/design/routing-identity-audit-20260908.md R11). Was 300000 -> 1h = 4x the floor.
# Topics with their own contract are unaffected: audit 30d, command topics 1h,
# db_task per go-svc ConfigMap, match-results 7d.
KAFKA_LOG_RETENTION_MS=3600000
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=120000
KAFKA_LOG_RETENTION_BYTES=536870912
KAFKA_LOG_SEGMENT_BYTES=33554432
KAFKA_NUM_IO_THREADS=8
KAFKA_NUM_NETWORK_THREADS=3
KAFKA_BACKGROUND_THREADS=10
KAFKA_MEM_LIMIT=1536M
KAFKA_CPU_LIMIT=2.0
KAFKA_TMPFS_SIZE=512m
KAFKA_UI_JAVA_OPTS=-Xms256m -Xmx512m
KAFKA_UI_MEM_LIMIT=768M
KAFKA_UI_CPU_LIMIT=1.0
