<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.game</groupId>
    <artifactId>gateway-node</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gateway-node</name>
    <description>Zone Directory + Gateway Service</description>

    <properties>
        <java.version>23</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jetcd.version>0.8.5</jetcd.version>
        <protobuf.version>3.25.5</protobuf.version>
        <jvm.warning.suppression.args>-XX:+EnableDynamicAgentLoading -Xshare:off</jvm.warning.suppression.args>
        <!-- 发布版本戳(docs/design/release-packaging-standard-20260914.md P1),由
             spring-boot-maven-plugin 的 build-info 写进 META-INF/build-info.properties,
             actuator /actuator/info 的 build 段读它。镜像构建(deploy/k8s/Dockerfile.java-svc)用
             -Dmmorpg.build.version / -Dmmorpg.build.commit 覆盖;本地与 CI 的 mvn test 不传,取下面默认值。
             命令行 -D 的优先级高于这里的 properties,所以默认值不会盖掉传入值。 -->
        <mmorpg.build.version>${project.version}</mmorpg.build.version>
        <mmorpg.build.commit>unknown</mmorpg.build.commit>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA + MySQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- etcd (jetcd) -->
        <dependency>
            <groupId>io.etcd</groupId>
            <artifactId>jetcd-core</artifactId>
            <version>${jetcd.version}</version>
        </dependency>

        <!-- Protobuf JSON (for parsing etcd NodeInfo values) -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- Scheduling (health probe) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Rate limiting (Bucket4j + Redis via Lettuce; gateway already pulls Lettuce
             through spring-boot-starter-data-redis, so no extra Redis client needed). -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-redis</artifactId>
            <version>8.10.1</version>
            <exclusions>
                <!-- We only use the Lettuce backend; exclude the other transports
                     so we don't drag Redisson + Jedis into the gateway. -->
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>redis.clients</groupId>
                    <artifactId>jedis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- gRPC client to go-zero login.rpc. Versions are aligned with the
             protobuf-java already on the classpath (3.25.x). -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>1.68.1</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>1.68.1</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>1.68.1</version>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>${jvm.warning.suppression.args}</jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <!-- build-info 默认绑定 generate-resources,mvn test / package 都会生成。
                             build-info goal 没有 version 参数,build.version 固定取 project.version;
                             additionalProperties 在 spring-boot-loader-tools 3.4.3 的 BuildPropertiesWriter
                             里排在标准字段之后写入,同名 version 会覆盖它(2026-09-16 核对该版本字节码)。
                             升级 Spring Boot 后若这里失效,表现是 /actuator/info 的 build.version 变回
                             project.version,而不是构建失败,升级时要回归一次。
                             值不能为 null(插件会拒),所以两个属性都在 <properties> 里给了默认值。 -->
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <version>${mmorpg.build.version}</version>
                                <commit>${mmorpg.build.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${jvm.warning.suppression.args} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
