+		t.Fatalf("ResolveSharedRedisPassword: %v", err)
+	}
+	if c.RedisClient.Password != "pw-from-secret" {
+		t.Fatalf("RedisClient must get the password, got %q", c.RedisClient.Password)
+	}
+}
