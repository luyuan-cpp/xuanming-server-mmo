+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+// sharedRedisEnv 是 os.LookupEnv 形状的桩,单测不读真实环境变量。
+func sharedRedisEnv(env map[string]string) func(string) (string, bool) {
+	return func(name string) (string, bool) {
