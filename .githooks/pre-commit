#!/bin/sh
# 提交前门禁：仅检查暂存区中改动的 C++ 源码（裸指针成员 + 异步回调捕获，与 CI 规则一致）。
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 非 C++ 提交直接放行，避免启动 Python 解释器。
STAGED_CPP="$(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACMR -- cpp/)"
if [ -z "$STAGED_CPP" ]; then
    exit 0
fi

RAW_PTR_CHECKER="$REPO_ROOT/tools/scripts/tests/test_cpp_no_raw_pointer_member.py"
ASYNC_CB_CHECKER="$REPO_ROOT/tools/scripts/tests/test_cpp_async_callback_capture.py"
for checker in "$RAW_PTR_CHECKER" "$ASYNC_CB_CHECKER"; do
    if [ ! -f "$checker" ]; then
        echo "[pre-commit] ERROR: checker script not found: $checker" >&2
        exit 1
    fi
done

PYTHON_CMD=""
for candidate in python python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)" >/dev/null 2>&1; then
        PYTHON_CMD="$candidate"
        break
    fi
done

run_checker() {
    if [ -n "$PYTHON_CMD" ]; then
        "$PYTHON_CMD" -X utf8 -B "$1" --staged
    elif command -v py >/dev/null 2>&1 && py -3 -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
        py -3 -X utf8 -B "$1" --staged
    else
        echo "[pre-commit] ERROR: Python 3 not found; cannot run C++ static checks." >&2
        return 1
    fi
}

STATUS=0
for checker in "$RAW_PTR_CHECKER" "$ASYNC_CB_CHECKER"; do
    if ! run_checker "$checker"; then
        STATUS=1
    fi
done
exit "$STATUS"
