# Force LF line endings for all text files.
* text=auto eol=lf

# Ensure these extensions are always treated as text with LF.
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.go text eol=lf
*.java text eol=lf
*.proto text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.tmpl text eol=lf
*.sql text eol=lf

# 进度流水账只追加:本机与远端各自往末尾追加条目时用 union 合并(两边都保留,本机的在前)。
# 不配的话,每小时自动保存的 git pull 每次都会卡成未完成的合并(2026-10-10 一天三次,都只冲突这一个文件)。
# 代价:union 从不报冲突 —— 两边改的是同一段(例如都去补最后一条旧条目)而不是各自追加新条目时,
# 两个版本都会留下且顺序可能不对,要靠评审发现。所以补充旧条目请另起一条,不要回头改最后一条。
docs/PROGRESS.md merge=union

# Binary files — do not touch.
*.exe binary
*.dll binary
*.lib binary
*.exp binary
*.pdb binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.gz binary
*.nav binary
*.navmesh binary

# 补丁文件必须逐字节保留:内容是 CRLF 的 vcxproj diff,
# 被 text=auto 归一成 LF 后在新 clone 上 git apply 必然失败。
*.patch -text
